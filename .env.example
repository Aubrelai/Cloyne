APP_NAME=Cloyne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloyne: LaiQ packages on sale right now (keys from config/cloyne.php).
# Cloyne only pitches these, but still shows each lead's best-fit package.
# To pause a package, leave it out, e.g. CLOYNE_SELLING=website
CLOYNE_SELLING=website,ads_crm,scale

# Lead Finder: your Apify API token (Apify Console → Settings → API & Integrations).
# Never share this or commit it to GitHub; .env is already ignored by git.
APIFY_TOKEN=

# Optional: check emails are real before drafts (https://millionverifier.com)
MILLIONVERIFIER_KEY=
# Rough Apify price per 1,000 businesses found (for the cost shown before a search).
APIFY_PRICE_PER_1000=4

# AI audit: your Claude API key (console.anthropic.com → API Keys). Never share or commit it.
ANTHROPIC_API_KEY=
# Model used for audits (cheap and fast). Leave as is unless you want to change it.
ANTHROPIC_AUDIT_MODEL=claude-haiku-5-5
# Audit new leads automatically when a Lead Finder search finishes (true/false).
CLOYNE_AUTO_AUDIT=true

# Outreach emails (Step 4). Model that writes them, and whether hot leads get one automatically.
ANTHROPIC_DRAFT_MODEL=claude-sonnet-5-5
CLOYNE_AUTO_DRAFT=true
# Where people book a call (shown in emails).
CLOYNE_BOOKING_URL=https://admin.laiqdigital.com/booking/laiq-digital/strategy-call
# Postal address for the bottom of every email (required by law; a PO box or virtual mailbox is fine).
# Use quotes, e.g. CLOYNE_MAILING_ADDRESS="LaiQ Digital, 123 Main St, Miami, FL 33101"
CLOYNE_MAILING_ADDRESS=
